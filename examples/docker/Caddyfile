{
    # Required by the container runner and caddy reload. Not published to host.
    admin 127.0.0.1:2019
}

# Merge this example into your existing configuration; preserve other sites.
control.example.com {
    @allowed {
        remote_ip 192.0.2.20
        path / /apps /apps/* /healthz
    }
    handle @allowed {
        reverse_proxy 127.0.0.1:9000
    }
    handle {
        respond "Forbidden" 403
    }
}

import /etc/caddy/sandbox/sandbox.caddy
