# Replace the IPs, paths and token with your real values.
# VM running Caddy/API. Must be reachable from the Caddy container.
CS_LISTEN=192.0.2.10:9000
CS_TOKEN=REPLACE_WITH_RANDOM_TOKEN
CS_UPSTREAM_IP=192.0.2.20
CS_DOMAIN_SUFFIX=sandbox.example.com
CS_PUBLIC_URL=https://control.example.com
CS_MIN_PORT=10000
CS_MAX_PORT=10099
CS_FILE=/opt/caddy/config/sandbox.caddy
CS_CONTAINER=caddy
CS_CONTAINER_CONFIG=/etc/caddy/Caddyfile
CS_DOCKER=/usr/bin/docker
